# Mathia — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# ── Django ───────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL) ────────────────────────────────────────────
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Leave unset for SQLite (dev only).

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Providers ────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
HF_API_TOKEN=

# ── Telegram Bot (required for TG integration) ───────────────────────
# Get TELEGRAM_BOT_TOKEN from @BotFather on Telegram.
# TELEGRAM_API_ID and TELEGRAM_API_HASH from https://my.telegram.org/apps
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=MathiaBot
TELEGRAM_WEBHOOK_SECRET=  # random 32-char string; set via BotFather webhook
TELEGRAM_MINI_APP_URL=    # https://<your-railway-project>.up.railway.app

# ── Telegram SIGNET Collector (optional) ─────────────────────────────
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_STRING=
# TELEGRAM_DEFAULT_CHANNELS=@channel1,@channel2

# ── External APIs ────────────────────────────────────────────────────
OPENWEATHER_API_KEY=
GIPHY_API_KEY=
EXCHANGE_RATE_API_KEY=

# ── Calendly ─────────────────────────────────────────────────────────
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
Webhook_signing_key=

# ── Reddit (SIGNET collector) ────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=Mathia/1.0

# ── OAuth (Social Login) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Cloudflare R2 / S3 Storage (optional) ────────────────────────────
R2_ENABLED=False
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_REGION=auto

# ── Pentest Agent (optional, gated) ──────────────────────────────────
PENTEST_AGENT_ENABLED=False
PENTEST_AGENT_SHARED_TOKEN=
